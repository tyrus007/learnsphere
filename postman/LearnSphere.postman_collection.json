{
  "info": {
    "_postman_id": "learnsphere-collection-v1",
    "name": "LearnSphere",
    "description": "LearnSphere Microservices API Collection.\n\nOrganised by service:\n- **Auth** — Identity Service (register, login, profile)\n- **Courses** — Course Service (catalog & content)\n- **Enrollment** — Enrollment Service (student enrollment)\n- **Progress** — Progress Service (lesson completion & course progress)\n- **Notifications** — Notification Service (in-app notifications)\n\nBase URL is driven by the `gateway_url` environment variable.\nAfter login, `student_token` and `instructor_token` are set automatically by the post-response scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:8080",
      "type": "string",
      "description": "API Gateway base URL. Change to http://localhost:808X to hit a service directly during development."
    },
    {
      "key": "student_token",
      "value": "",
      "type": "string",
      "description": "JWT for the student account. Auto-populated by the Login (Student) request script."
    },
    {
      "key": "instructor_token",
      "value": "",
      "type": "string",
      "description": "JWT for the instructor account. Auto-populated by the Login (Instructor) request script."
    },
    {
      "key": "course_id",
      "value": "",
      "type": "string",
      "description": "UUID of the last created course. Set manually or by a test script."
    },
    {
      "key": "module_id",
      "value": "",
      "type": "string",
      "description": "UUID of the last created module."
    },
    {
      "key": "lesson_id",
      "value": "",
      "type": "string",
      "description": "UUID of the last created lesson."
    },
    {
      "key": "enrollment_id",
      "value": "",
      "type": "string",
      "description": "UUID of the last created enrollment."
    },
    {
      "key": "notification_id",
      "value": "",
      "type": "string",
      "description": "UUID of the last notification."
    },
    {
      "key": "student_user_id",
      "value": "",
      "type": "string",
      "description": "UUID of the student user. Auto-populated by register/login scripts."
    },
    {
      "key": "instructor_user_id",
      "value": "",
      "type": "string",
      "description": "UUID of the instructor user. Auto-populated by register/login scripts."
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Identity Service — authentication and user profile endpoints.\nBase path: /api/auth and /api/users\nService port (direct): 8081",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Alice Student\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"STUDENT\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/auth/register",
              "host": ["{{gateway_url}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Register a new STUDENT account.\nExpected: 201 Created with JWT in response body."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('student_token', body.token);",
                  "  pm.collectionVariables.set('student_user_id', body.userId);",
                  "  console.log('student_token set:', body.token);",
                  "}",
                  "pm.test('Register Student — 201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Instructor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Bob Instructor\",\n  \"email\": \"bob@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"INSTRUCTOR\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/auth/register",
              "host": ["{{gateway_url}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Register a new INSTRUCTOR account.\nExpected: 201 Created with JWT in response body."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('instructor_token', body.token);",
                  "  pm.collectionVariables.set('instructor_user_id', body.userId);",
                  "  console.log('instructor_token set:', body.token);",
                  "}",
