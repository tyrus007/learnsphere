        {
          "name": "Edit Course (Different Instructor — Forbidden)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{student_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hijacked Title\",\n  \"description\": \"Should not work.\",\n  \"level\": \"BEGINNER\",\n  \"category\": \"Test\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/courses/{{course_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["api", "courses", "{{course_id}}"]
